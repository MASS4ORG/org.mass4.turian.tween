<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NoWarn>$(NoWarn);CA1707</NoWarn>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../Source/Turian.Tweening/Turian.Tweening.csproj"/>
        <ProjectReference Include="$(TurianDir)Turian/Editor/CSharp/CodeGenerator/Turian.CSharp.CodeGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <Compile Include="$(TurianDir)Turian.Tests/SerialTests.cs" Link="Shared/SerialTests.cs"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14"/>
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0"/>
        <PackageReference Include="xunit.v3" Version="4.0.2"/>
    </ItemGroup>
</Project>
